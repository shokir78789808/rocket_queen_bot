@bot.message_handler(func=lambda message: True)
def all_messages(message):
    user_id = message.from_user.id
    today = str(datetime.date.today())

    if user_id not in user_limits or user_limits[user_id]["date"] != today:
        user_limits[user_id] = {"date": today, "count": 0}

    if user_limits[user_id]["count"] >= 5:
        bot.send_message(
            message.chat.id,
            "⛔️ Шумо лимити имрузаро истифода бурдед (5/5)!\n\n"
            "Барои он ки аккаунти шумо блок нашавад, пагоҳ метавонед боз сигнал гиред."
        )
        return

    user_limits[user_id]["count"] += 1
    num = user_limits[user_id]["count"]

    coef = round(random.uniform(1.25, 8.55), 2)
    chance = random.randint(88, 98)

    wait_msg = bot.send_message(message.chat.id, "🔍 Анализ ракета...")
    time.sleep(1)
    try:
        bot.delete_message(message.chat.id, wait_msg.message_id)
    except:
        pass

    signal_msg = (
        f"🚀 ROCKET QUEEN СИГНАЛ #{num}\n"
        f"━━━━━━━━━━━━━━━━━━\n"
