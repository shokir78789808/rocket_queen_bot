        f"📊 Лимит: {num}/5\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"⚠️ Пеш аз ин коэффициент маблағро гиред!"
    )
    bot.send_message(message.chat.id, signal_msg)

